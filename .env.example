# ─── API ───────────────────────────────────────────────
# Copy to apps/api/.env and fill in real values

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://boost:boost_dev_password@localhost:5432/boost

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# App deep link base URL (for invite emails)
APP_DEEP_LINK_BASE=boost://invite
